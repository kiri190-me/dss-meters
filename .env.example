# ------------------------------------------------------------------
# DSS 계측기 관리 시스템 — 환경변수 예시
#
# 이 파일을 복사해서 .env.local 을 만들고 실제 값을 채운다.
#   cp .env.example .env.local
#
# .env.local 은 git 에 올리지 않는다. 비밀번호를 여기에 적지 않는다.
# ------------------------------------------------------------------

# PostgreSQL 접속 주소
#
# 포트가 5438인 이유: 이 개발 PC 에서 A/S 관리 시스템이 5432, dss-auth 가
# 5434, dss-home 이 5436 을 이미 쓴다. docker-compose.yml 참고.
DATABASE_URL=postgres://dss_meters_app:CHANGE_ME@127.0.0.1:5438/dss_meters_dev

# docker-compose.yml 이 읽는 값. 위 DATABASE_URL 의 비밀번호와 같아야 한다.
DEV_POSTGRES_PASSWORD=CHANGE_ME

# 이 사이트가 쓸 포트 (A/S 3000 · dss-auth 3100 · dss-home 3200 과 겹치지 않게)
PORT=3300

# 업로드 파일 저장 루트 (절대경로)
#   Windows 개발 PC : C:/WEB-DATA/dss-meters
#   NAS 컨테이너    : /data
FILE_STORAGE_ROOT=C:/WEB-DATA/dss-meters

# 세션 쿠키에 secure 를 붙일지.
# 사내망 HTTP 단계에서 true 로 켜면 쿠키가 저장되지 않아 로그인이 조용히 실패한다.
# HTTPS 를 붙인 뒤에 true 로 바꾼다.
SESSION_COOKIE_SECURE=false

# 세션 수명(시간). dss-auth SSO 세션의 절대 만료 12시간을 넘기지 않는다.
SESSION_HOURS=12

# ------------------------------------------------------------------
# DSS 통합 로그인 (dss-auth 포털)
#
# 이 사이트는 자체 로그인을 만들지 않는다. 포털이 신원을 확인하고,
# 여기서는 그 결과(ID 토큰)만 검증해 자기 세션을 발급한다.
#
# 이름을 SSO_ 로 맞춘 이유: A/S 관리 시스템도 같은 이름을 쓴다. Wi-Fi 가
# 바뀌어 IP 가 달라지면 두 시스템을 같은 방식으로 고칠 수 있어야 한다.
# ------------------------------------------------------------------

# 포털 주소. ID 토큰의 iss 와 문자 단위로 같아야 한다. 끝에 / 를 붙이지 않는다.
SSO_ISSUER=auto

# 포털에 등록된 이 시스템의 식별자
SSO_CLIENT_ID=dss-meters

# 포털에서 발급받은 시크릿. 발급 시 한 번만 표시된다.
# NEXT_PUBLIC_ 접두사를 붙이지 않는다 — 브라우저로 새어나간다.
SSO_CLIENT_SECRET=

# 포털이 로그인 결과를 돌려보낼 주소.
# 포털에 등록한 값과 문자 단위로 같아야 한다. 요청에서 만들어 쓰지 않는다 —
# LAN 접속에서 실제와 다른 값이 나오는 사례가 A/S 시스템에서 실측되었다.
SSO_REDIRECT_URI=auto

# 로그인 왕복 동안 state·nonce·PKCE 검증값을 나르는 쿠키의 서명 키. 32자 이상.
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SSO_TX_SECRET=

# 알림 메일에 넣을 사이트 주소 (비우면 http://localhost:3300)
SITE_URL=http://localhost:3300

# ------------------------------------------------------------------
# 교정 기한 알림 메일 (3차 작업 — cafe24 SMTP)
# ------------------------------------------------------------------
# cafe24 웹메일의 「환경설정 → POP3/SMTP 사용설정」 화면에 적힌 값이다.
# 그 화면에서 SMTP 연결을 '사용함' 으로 켜 두어야 로그인이 된다.
# 465 는 열려 있지 않다. 587 로 붙어 STARTTLS 로 올린다.
SMTP_HOST=smtp.cafe24.com
SMTP_PORT=587
# SMTP_USER=사람@dss21.com
# SMTP_PASSWORD=
# SMTP_FROM=  (비우면 SMTP_USER 를 쓴다)

# ------------------------------------------------------------------
# 백업 (npm run backup) — docs/BACKUP.md 참고
# ------------------------------------------------------------------
# 백업을 받을 곳. NAS 안이 기본이다.
BACKUP_ROOT=//192.168.0.222/2_as센터/3. 계측기 관리/8. 계측기 관리 시스템 백업

# PostgreSQL bin 폴더 (pg_dump 위치). 비워두면 PATH 에서 찾는다.
PG_BIN=C:/Users/이남준/pgsql/bin

# 남겨 둘 DB 백업 개수. 매일 돌리면 이 숫자가 곧 보관 일수다.
BACKUP_KEEP=30

# NAS 의 교정 성적서 원본 폴더 (npm run import-certs). 읽기만 한다.
CERT_SOURCE_ROOT=//192.168.0.222/2_as센터/3. 계측기 관리/4. 계측기 성적서
