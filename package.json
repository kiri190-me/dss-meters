{
  "name": "dss-meters",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -H 0.0.0.0 -p 3300",
    "build": "next build --webpack",
    "start": "next start -H 0.0.0.0 -p 3300",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose --env-file .env.local up -d db-dev",
    "db:down": "docker compose --env-file .env.local down",
    "db:psql": "docker exec -it dss-meters-postgres-dev psql -U dss_meters_app -d dss_meters_dev",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx scripts/seed.ts",
    "sso:link": "tsx scripts/sso-link.ts",
    "backup": "tsx scripts/backup.ts",
    "import-certs": "tsx scripts/import-certs.ts",
    "backfill-calibrations": "tsx scripts/backfill-calibrations.ts",
    "check-smtp": "tsx scripts/check-smtp.ts",
    "preview-notify": "tsx scripts/preview-notify.ts",
    "send-notify": "tsx scripts/send-notify.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "jose": "^6.2.10",
    "next": "16.3.3",
    "nodemailer": "^9.0.6",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
